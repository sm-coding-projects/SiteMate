# Copy to .env. Read by Vite and inlined into the SPA (public value). Development instance key for `pnpm dev`;
# production builds read .env.production over this, so put the production key there:
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Optional: landing-page "Request access" opens a mailto to this address. Unset = it explains invites instead.
# VITE_ACCESS_REQUEST_EMAIL=you@example.com
