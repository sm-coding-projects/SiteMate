{
	"name": "sitemate",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "pnpm build && vite preview",
		"deploy": "pnpm build && wrangler deploy",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"format": "biome format --write .",
		"cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply sitemate-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply sitemate-db --remote"
	},
	"dependencies": {
		"@clerk/backend": "^3.22.0",
		"@clerk/hono": "^0.1.85",
		"@clerk/react": "^6.17.5",
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tanstack/react-query": "^5.104.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.12",
		"lucide-react": "^1.50.0",
		"radix-ui": "^1.6.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "^8.4.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.62.5",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"drizzle-kit": "^0.31.11",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	}
}
