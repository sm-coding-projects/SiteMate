{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sitemate",
	"main": "./src/worker/index.ts",
	// Bump when upgrading wrangler; must not be newer than the bundled workerd.
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// The Worker sees page requests (to send each hostname to its part of the site, src/worker/hosts.ts);
		// built files under /assets and the favicon are served straight from the edge.
		"run_worker_first": ["/*", "!/assets/*", "!/favicon.svg"]
	},
	// bfhapp.com serves the landing page, app.bfhapp.com the app. bfhapp.com is a Custom Domain (DNS and
	// certificate created on deploy). app.bfhapp.com is a zone route on a proxied placeholder record
	// (AAAA app → 100::, added in the dashboard) because Cloudflare didn't create its Custom Domain record.
	"routes": [
		{ "pattern": "bfhapp.com", "custom_domain": true },
		{ "pattern": "app.bfhapp.com/*", "zone_name": "bfhapp.com" }
	],
	// Keep sitemate.<subdomain>.workers.dev working as a fallback (serves everything on one origin).
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sitemate-db",
			// Created with `wrangler d1 create sitemate-db --location oc`
			"database_id": "c72e69a0-17a1-4c9c-8d47-3d23ddb336c2",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "sitemate-files",
			// Browsers upload straight to the real bucket with presigned URLs, so `pnpm dev` must read the same
			// bucket. Ignored by `wrangler deploy` and by tests (which use a local bucket).
			"remote": true
		}
	],
	"queues": {
		"producers": [{ "binding": "JOBS", "queue": "sitemate-jobs" }],
		"consumers": [
			{
				"queue": "sitemate-jobs",
				"max_batch_size": 5,
				"max_batch_timeout": 5,
				// Extraction and email jobs retry with backoff, then the consumer marks them failed.
				"max_retries": 3
			}
		]
	},
	// Workers AI (free 10k neurons/day). Always runs remotely, also in `pnpm dev`.
	"ai": { "binding": "AI", "remote": true },
	"vars": {
		"APP_ENV": "production",
		// Public origin of the app, used in email links. Also add it to AUTHORIZED_PARTIES (secret).
		"APP_URL": "https://app.bfhapp.com",
		// Landing page host and app host (see "routes"). Unset either to serve everything on every host.
		"SITE_HOST": "bfhapp.com",
		"APP_HOST": "app.bfhapp.com",
		"R2_BUCKET": "sitemate-files",
		// workers-ai | anthropic | openai-compatible. Falls back to workers-ai when the chosen provider has no key.
		"AI_PROVIDER": "workers-ai",
		// AI Gateway (Dashboard → AI → AI Gateway). Every provider call is routed through it.
		"AI_GATEWAY_ID": "sitemate",
		"WORKERS_AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
		"ANTHROPIC_MODEL": "claude-opus-5-5",
		"OPENAI_COMPAT_MODEL": "openai/gpt-5-mini",
		// sandbox: every email goes to EMAIL_SANDBOX_TO (secret) with the intended recipient in the subject.
		// live: needs a verified Resend domain and an EMAIL_FROM on it.
		"EMAIL_MODE": "sandbox",
		"EMAIL_FROM": "BFH App <onboarding@resend.dev>",
		// Resend free tier allows 100/day; keep headroom.
		"EMAIL_DAILY_LIMIT": "90"
	}
}
